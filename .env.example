# eufy account
EUFY_USERNAME=you@example.com
EUFY_PASSWORD=change-me
# ISO 3166-1 alpha-2 code of the account country
EUFY_COUNTRY=US
# serial of the lock, only when the account has several locks
EUFY_LOCK=
# folder for the eufy session, default ./data
DATA_DIR=

# API only. Generate the token with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
API_TOKEN=
HOST=127.0.0.1
PORT=8090
